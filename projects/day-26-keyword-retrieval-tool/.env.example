m# Optional Azure AI Search configuration for Phase 5.
# Copy this file to .env for local reference only; never commit .env or real secrets.
# Export these variables in the terminal that launches the CLI or VS Code.

AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=your-index-name
AZURE_SEARCH_API_KEY=replace-with-a-query-or-admin-key
